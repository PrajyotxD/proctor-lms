rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function roleIn(roles) {
      return signedIn() && request.auth.token.role in roles;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /evidence/{examId}/{attemptId}/{fileName} {
      allow read: if roleIn(['admin', 'teacher']);
      allow write: if roleIn(['student', 'teacher', 'admin']);
    }

    match /verification/{uid}/{fileName} {
      allow read: if isOwner(uid) || roleIn(['admin', 'teacher']);
      allow write: if isOwner(uid) || roleIn(['admin']);
    }

    match /feedback/{attemptId}/{fileName} {
      allow read: if roleIn(['admin', 'teacher']);
      allow write: if roleIn(['teacher', 'admin']);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
